{
  "model": "pets.dog",
  "pk": 1,
  "fields": {
    "name": "柯基犬",
    "category": 1,
    "price": "5000.00",
    "image_url": "/static/images/柯基犬.png",
    "description": "柯基犬原产于英国威尔士，是一种小型牧羊犬。它们以短腿、大耳朵和活泼的性格而闻名。柯基聪明机警，对主人忠诚，非常适合家庭饲养。虽然体型小巧，但它们精力充沛，每天都需要适量的运动。",
    "color": "黄白相间、三色",
    "weight": "10-14kg",
