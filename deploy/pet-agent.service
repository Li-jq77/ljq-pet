[Unit]
Description=Pet Agent Django Gunicorn
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pet-agent
EnvironmentFile=/opt/pet-agent/.env
ExecStart=/opt/pet-agent/.venv/bin/gunicorn pet_agent.wsgi --workers 3 --bind 127.0.0.1:8000 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
